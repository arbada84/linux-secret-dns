#!/usr/bin/env bash
# SecretDNS 토글 + 데스크톱 알림 wrapper
# 시작 메뉴에서 호출됨 (사용자 권한으로 실행)

export LANG=ko_KR.UTF-8

# 토글 실행 (비밀번호 없이 sudo)
sudo /home/arbada/bin/secretdns toggle

# pkexec 완료 후 사용자 권한으로 돌아와 현재 상태 확인
if systemctl is-active --quiet dnscrypt-proxy 2>/dev/null && \
   systemctl is-active --quiet tpws 2>/dev/null; then
    notify-send \
        --icon=network-vpn \
        --urgency=normal \
        --expire-time=4000 \
        "🔒 SecretDNS 켜짐" \
        "DNS 암호화(DoH) + SNI 파편화 보호 중\nISP가 방문 사이트를 볼 수 없습니다"
elif systemctl is-active --quiet dnscrypt-proxy 2>/dev/null; then
    notify-send \
        --icon=network-vpn \
        --urgency=normal \
        --expire-time=4000 \
        "⚠️ SecretDNS 부분 활성" \
        "DNS 암호화(DoH) 켜짐, SNI 파편화 꺼짐"
else
    notify-send \
        --icon=network-vpn \
        --urgency=low \
        --expire-time=4000 \
        "🔓 SecretDNS 꺼짐" \
        "기본 DNS로 복원됨\nISP DNS 사용 중"
fi
