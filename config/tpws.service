[Unit]
Description=tpws SNI fragmentation proxy (SecretDNS)
After=network.target

[Service]
Type=simple
ExecStartPre=/sbin/iptables -t nat -A OUTPUT -p tcp --dport 443 -m owner ! --uid-owner tpws -j REDIRECT --to-ports 988
ExecStartPre=/sbin/iptables -t nat -A OUTPUT -p tcp --dport 80  -m owner ! --uid-owner tpws -j REDIRECT --to-ports 988
ExecStopPost=/sbin/iptables -t nat -D OUTPUT -p tcp --dport 443 -m owner ! --uid-owner tpws -j REDIRECT --to-ports 988
ExecStopPost=/sbin/iptables -t nat -D OUTPUT -p tcp --dport 80  -m owner ! --uid-owner tpws -j REDIRECT --to-ports 988
ExecStart=/usr/local/bin/tpws \
  --port=988 \
  --user=tpws \
  --bind-addr=127.0.0.1 \
  --split-pos=method,sniext \
  --hostlist=/etc/zapret/tpws-domains.txt
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
