#!/usr/bin/env bash
# Linux SecretDNS — DoH + SNI 파편화 통합 토글 스크립트
# 사용법: secretdns [on|off|status|toggle]

set -e
export LANG=ko_KR.UTF-8

DOH_CONF="/etc/systemd/resolved.conf.d/20-doh.conf"
DOT_CONF="/etc/systemd/resolved.conf.d/10-dot.conf"
DOT_DISABLED="$DOT_CONF.disabled"

_is_doh_active() {
    systemctl is-active --quiet dnscrypt-proxy && \
    [ ! -f "$DOT_CONF" ] && [ -f "${DOH_CONF}" ]
}

_is_tpws_active() {
    systemctl is-active --quiet tpws
}

_require_root() {
    if [ "$EUID" -ne 0 ]; then
        if command -v pkexec &>/dev/null && [ -n "$DISPLAY" ]; then
            exec pkexec "$0" "$@"
        else
            exec sudo "$0" "$@"
        fi
    fi
}

cmd_status() {
    local doh_status tpws_status doh_server

    if _is_doh_active; then
        doh_status="🟢 켜짐 (DoH 활성)"
        doh_server=$(resolvectl status 2>/dev/null | grep "Current DNS Server" | head -1 | awk '{print $NF}')
    else
        doh_status="🔴 꺼짐"
    fi

    if _is_tpws_active; then
        tpws_status="🟢 켜짐 (SNI 파편화 활성)"
    else
        tpws_status="🔴 꺼짐"
    fi

    echo ""
    echo "======================================"
    echo "  Linux SecretDNS 상태"
    echo "======================================"
    echo ""
    echo "  [1] DNS over HTTPS (DoH)   : $doh_status"
    if _is_doh_active; then
        echo "      → dnscrypt-proxy → Cloudflare/Google/Quad9"
        echo "        ISP에 DNS 쿼리가 노출되지 않음"
    fi
    echo ""
    echo "  [2] SNI 파편화 (tpws)      : $tpws_status"
    if _is_tpws_active; then
        echo "      → TCP 80/443 패킷 분할"
        echo "        ISP DPI 장비가 방문 사이트를 감지하지 못함"
    fi
    echo ""
    if _is_doh_active && _is_tpws_active; then
        echo "  ✅ 완전 보호 중: DNS 쿼리 + SNI 모두 차단됨"
    elif _is_doh_active || _is_tpws_active; then
        echo "  ⚠️  부분 보호 중: secretdns on 으로 완전 활성화 권장"
    else
        echo "  ❌ 보호 비활성: ISP가 방문 사이트를 볼 수 있음"
    fi
    echo ""
}

cmd_on() {
    _require_root "$@"

    echo "→ SecretDNS 활성화 중..."

    # DoT 비활성화, DoH 활성화
    if [ -f "$DOT_CONF" ]; then
        mv "$DOT_CONF" "$DOT_DISABLED"
    fi

    # dnscrypt-proxy 시작
    systemctl start dnscrypt-proxy.socket dnscrypt-proxy
    # systemd-resolved 재시작 (127.0.2.1 적용)
    systemctl restart systemd-resolved

    # tpws 시작 (SNI 파편화)
    systemctl start tpws

    echo "✅ SecretDNS 켜짐: DoH + SNI 파편화 활성"
}

cmd_off() {
    _require_root "$@"

    echo "→ SecretDNS 비활성화 중..."

    # tpws 중지
    systemctl stop tpws 2>/dev/null || true

    # dnscrypt-proxy 중지
    systemctl stop dnscrypt-proxy 2>/dev/null || true

    # DoT 복원 (있는 경우)
    if [ -f "$DOT_DISABLED" ]; then
        mv "$DOT_DISABLED" "$DOT_CONF"
    fi

    # systemd-resolved 재시작
    systemctl restart systemd-resolved

    echo "❌ SecretDNS 꺼짐: 기본 DNS로 복원됨"
}

cmd_toggle() {
    if _is_doh_active && _is_tpws_active; then
        cmd_off "$@"
    else
        cmd_on "$@"
    fi
}

case "${1:-status}" in
    on)     cmd_on "$@" ;;
    off)    cmd_off "$@" ;;
    status) cmd_status ;;
    toggle) cmd_toggle "$@" ;;
    *)
        echo "사용법: secretdns [on|off|status|toggle]"
        echo ""
        echo "  on      — DoH + SNI 파편화 활성화"
        echo "  off     — 비활성화 (기본 DNS 복원)"
        echo "  status  — 현재 상태 확인"
        echo "  toggle  — 켜기/끄기 전환"
        exit 1
        ;;
esac
