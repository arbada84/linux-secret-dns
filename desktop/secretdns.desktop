[Desktop Entry]
Version=1.0
Type=Application
Name=SecretDNS
GenericName=DNS 암호화 + SNI 보호
Comment=DoH + SNI 파편화로 ISP 감청 차단 (켜기/끄기)
Exec=xfce4-terminal --title="SecretDNS" --command="bash -c 'secretdns toggle; echo; read -p \"엔터를 누르면 닫힙니다...\"'"
Icon=network-vpn
Terminal=false
Categories=Network;Settings;Security;
Keywords=DNS;DoH;SNI;보안;암호화;프라이버시;시크릿;
